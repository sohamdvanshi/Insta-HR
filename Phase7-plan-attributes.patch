+import { adminRequest,mutation } from '@/lib/adminApi'
+import { AdminFrame,Notice,fieldStyle,primaryStyle } from './AdminShell'
+type Definition={key:string;label:string;type:'money'|'integer'|'boolean'|'text';unit:string;defaultValue:unknown;system:boolean;enforced:boolean;unlimited?:boolean;min?:number;max?:number}
+function ValueInput({definition:d,value,onChange}:{definition:Definition;value:any;onChange:(v:any)=>void}) {
+ if(d.type==='boolean')return <select className={fieldStyle} value={String(value)} onChange={e=>onChange(e.target.value==='true')}><option value="true">{tr('Yes')}</option><option value="false">{tr('No')}</option></select>
+ const unlimited=d.type==='integer' && d.unlimited
+ return <div>{unlimited && <label className="block"><input type="checkbox" checked={value===null} onChange={e=>onChange(e.target.checked?null:0)}/>{tr('Unlimited')}</label>}<input required={value!==null} disabled={value===null} className={fieldStyle} type={d.type==='text'?'text':'number'} min={d.min??0} max={d.type==='money'?1000000:d.max??100000000} step={d.type==='money'?'0.01':'1'} maxLength={200} value={value===null?'':d.type==='money'?value/100:value} onChange={e=>onChange(d.type==='text'?e.target.value:d.type==='money'?Math.round(Number(e.target.value)*100):e.target.value===''?'':Number(e.target.value))}/></div>
+}
+export default function PlanCatalog(){
+ useLocale()
+ const [plans,setPlans]=useState<any[]>([]),[defs,setDefs]=useState<Definition[]>([]),[error,setError]=useState(''),[success,setSuccess]=useState(''),[busy,setBusy]=useState(false),[reasons,setReasons]=useState<Record<string,string>>({})
+ const [form,setForm]=useState({key:'',label:'',type:'integer',unit:'',defaultValue:'0',unlimited:false,reason:''}),[editing,setEditing]=useState(''),[metadata,setMetadata]=useState({label:'',unit:'',reason:''})
+ async function load(){const r=await adminRequest('/admin/workspace/plan-catalog');setPlans(r.data);setDefs(r.attributeDefinitions)}
+ useEffect(()=>{void load().catch(e=>setError(e.message))},[])
+ async function run(fn:()=>Promise<void>){setBusy(true);setError('');setSuccess('');try{await fn();await load();setSuccess('Settings saved and recorded in the audit log.')}catch(e){setError((e as Error).message)}finally{setBusy(false)}}
